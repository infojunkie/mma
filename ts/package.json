{
  "name": "@music-i18n/mma",
  "version": "0.3.0",
  "description": "Musical MIDI Accompaniment — browser-first TypeScript library",
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "grooves": "node scripts/build-grooves.mjs",
    "demo": "npm run build && npm run grooves && ws -d demo -p ${PORT:-8087} -z --log.format combined",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "spessasynth_core": "^4.3.22"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "local-web-server": "^5.4.0",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
